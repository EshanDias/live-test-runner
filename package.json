{
  "name": "live-test-runner",
  "private": true,
  "version": "3.2.0",
  "publisher": "EshLabs",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EshanDias/live-test-runner"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "rebuild": "rimraf --glob \"packages/*/{dist,build,out,tsconfig.tsbuildinfo}\" && pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "start": "pnpm --filter live-test-runner run watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2"
  },
  "packageManager": "pnpm@12.14.0"
}
