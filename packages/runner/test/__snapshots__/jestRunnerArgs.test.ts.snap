exports[`JestRunner command lines (plain Jest) puts the user command first and its extra words before the Jest args 1`] = `
[
  {
    "args": [
      "test",
      "--",
      "--resetMocks",
      "--watchAll=false",
      "--forceExit",
      "--no-bail",
      "--testLocationInResults",
      "--maxWorkers=<n>",
      "--json",
      "--runTestsByPath",
      "<root>/src/a.test.js",
    ],
    "binary": "npm",
    "cwd": "<root>",
    "timeoutMs": 0,
  },
]
`;

