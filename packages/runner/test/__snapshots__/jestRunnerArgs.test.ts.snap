// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`JestRunner command lines (Create React App) passes the extracted config and the test-script flags (without --config) 1`] = `
[
  {
    "args": [
      "--config",
      "<root>/cra-config.json",
      "--resetMocks",
      "--watchAll=false",
      "--forceExit",
      "--no-bail",
      "--testLocationInResults",
      "--maxWorkers=<n>",
      "--json",
      "--runTestsByPath",
      "<root>/src/App.test.js",
    ],
    "binary": "<root>/node_modules/jest/bin/jest.js",
    "cwd": "<root>",
    "timeoutMs": 0,
  },
]
`;

exports[`JestRunner command lines (plain Jest) builds every run kind exactly as before 1`] = `
[
  {
    "args": [
      "--resetMocks",
      "--watchAll=false",
      "--forceExit",
      "--no-bail",
      "--testLocationInResults",
      "--maxWorkers=<n>",
      "--listTests",
      "--passWithNoTests",
