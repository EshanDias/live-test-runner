    "binary": "<root>/node_modules/jest/bin/jest.js",
    "cwd": "<root>",
    "timeoutMs": 5000,
  },
  {
    "args": [
      "--resetMocks",
      "--watchAll=false",
      "--forceExit",
      "--no-bail",
      "--testLocationInResults",
      "--maxWorkers=<n>",
      "--json",
      "--runTestsByPath",
      "<root>/src/a.test.js",
      "<root>/src/b.test.js",
