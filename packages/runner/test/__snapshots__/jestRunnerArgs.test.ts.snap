      "--coverage",
      "--coverageReporters=json",
      "--coverageReporters=json-summary",
    ],
    "binary": "<root>/node_modules/jest/bin/jest.js",
    "cwd": "<root>",
    "timeoutMs": undefined,
  },
  {
    "args": [
      "--resetMocks",
      "--watchAll=false",
      "--forceExit",
      "--no-bail",
      "--testLocationInResults",
