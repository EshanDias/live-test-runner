      "--no-bail",
      "--testLocationInResults",
      "--maxWorkers=<n>",
      "--json",
      "--runTestsByPath",
      "<root>/src/a.test.js",
      "--testNamePattern",
      "^(?:Suite)(?: |$)",
    ],
    "binary": "<root>/node_modules/jest/bin/jest.js",
    "cwd": "<root>",
    "timeoutMs": 5000,
