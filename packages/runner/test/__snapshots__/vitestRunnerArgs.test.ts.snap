      "run",
      "<root>/src/a.test.ts",
      "--config",
      "<root>/vitest.config.ts",
      "--reporter=default",
      "--reporter=<tmp>/ltr-vitest-reporter.mjs",
      "--reporter=json",
      "--includeTaskLocation",
      "--passWithNoTests",
      "--watch=false",
