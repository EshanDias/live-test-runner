    "label": "vitest",
    "timeoutMs": 5000,
  },
  {
    "args": [
      "run",
      "<root>/src/a.test.ts",
      "<root>/src/b.test.ts",
      "--config",
      "<root>/vitest.config.ts",
      "--reporter=default",
      "--reporter=<tmp>/ltr-vitest-reporter.mjs",
      "--reporter=json",
      "--includeTaskLocation",
      "--passWithNoTests",
