      "--reporter=json",
      "--includeTaskLocation",
      "--passWithNoTests",
      "--watch=false",
    ],
    "binary": "<root>/node_modules/vitest/vitest.mjs",
    "cwd": "<root>",
    "label": "vitest",
    "timeoutMs": undefined,
  },
  {
    "args": [
      "run",
      "--config",
      "<root>/vitest.config.ts",
      "--reporter=default",
      "--reporter=<tmp>/ltr-vitest-reporter.mjs",
      "--reporter=json",
      "--includeTaskLocation",
      "--passWithNoTests",
      "--watch=false",
