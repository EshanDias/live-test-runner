{
  "name": "live-test-runner",
  "displayName": "Live Test Runner",
  "description": "Live testing on save for Jest and other frameworks",
  "version": "3.0.0",
  "icon": "resources/images/live-test-runner.png",
  "publisher": "EshLabs",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EshanDias/live-test-runner",
    "directory": "packages/vscode-extension"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:liveTestRunner.explorer",
    "onView:liveTestRunner.results"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveTestRunnerContainer",
          "title": "Live Test Runner",
          "icon": "resources/icons/live_test_runner_vscode_logo.svg"
        }
      ],
      "panel": [
        {
          "id": "liveTestRunnerPanel",
          "title": "Live Test Results",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "liveTestRunnerContainer": [
        {
          "type": "webview",
          "id": "liveTestRunner.explorer",
          "name": "Test Explorer"
        }
      ],
      "liveTestRunnerPanel": [
        {
          "type": "webview",
          "id": "liveTestRunner.results",
          "name": "Live Test Results"
        }
      ]
    },
    "commands": [
      {
        "command": "liveTestRunner.startTesting",
        "title": "Start Testing",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.stopTesting",
        "title": "Stop Testing",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.stopAndClearCache",
        "title": "Stop Testing and Clear Cache",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.clearCacheAndRestart",
        "title": "Clear Cache and Restart Testing",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.selectProjectRoot",
        "title": "Select Project Root",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.showOutput",
        "title": "Show Test Output",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.showLogs",
        "title": "Show Logs",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.openGuide",
        "title": "Open Guide",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.copyDiagnostics",
        "title": "Copy Diagnostic Report",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.rerunFromEditor",
        "title": "Live Test Runner: Rerun Test at Line"
      },
      {
        "command": "liveTestRunner.debugFromEditor",
        "title": "Live Test Runner: Debug Test at Line"
      },
      {
        "command": "liveTestRunner.focusResult",
        "title": "Live Test Runner: Focus Test in Results Panel"
      },
      {
        "command": "liveTestRunner.openTimelineDebugger",
        "title": "Open Timeline Debugger",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.showCoveringTests",
        "title": "Show All Covering Tests",
        "category": "Live Test Runner"
      },
      {
        "command": "liveTestRunner.dumpTraceStore",
        "title": "Dump Trace Store (Debug)",
        "category": "Live Test Runner",
        "enablement": "config.liveTestRunner.devMode"
      }
    ],
    "keybindings": [
      {
        "command": "liveTestRunner.stopAndClearCache",
        "key": "shift+delete",
        "mac": "shift+delete",
        "when": "focusedView == liveTestRunner.results || focusedView == liveTestRunner.explorer"
      }
    ],
    "configuration": {
      "title": "Live Test Runner",
      "properties": {
        "liveTestRunner.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable developer debug commands (not intended for end users)"
        },
        "liveTestRunner.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Project root directory for testing"
        },
        "liveTestRunner.jestCommand": {
          "type": "string",
          "default": "",
          "description": "Override the Jest command (e.g. 'node_modules/.bin/jest'). Leave empty to auto-detect from package.json scripts and node_modules. Only used when runMode is 'extension'."
        },
        "liveTestRunner.vitestCommand": {
          "type": "string",
          "default": "",
          "description": "Override the Vitest command for Vitest projects (e.g. 'npx vitest'). Leave empty to run the project's own Vitest install. Live Test Runner adds its own subcommand and flags (run, --reporter=json, …) after it."
        },
        "liveTestRunner.vitestIncludeBrowserProjects": {
          "type": "boolean",
          "default": false,
          "description": "Vitest: also run browser-mode projects (Playwright / WebdriverIO). They need real browsers installed, so by default they are left out when the test script does not choose projects itself."
        },
        "liveTestRunner.runMode": {
          "type": "string",
          "enum": [
            "auto",
            "npm"
          ],
          "enumDescriptions": [
            "Extension manages Jest directly — full structured output, per-test durations, console capture.",
            "Use the project's 'npm test' script — respects your package.json test setup but provides limited structured output."
          ],
          "default": "auto",
          "description": "How tests are invoked. 'auto' (recommended): extension calls Jest directly with structured output. 'npm': delegates to 'npm test -- --json' from your package.json scripts."
        },
        "liveTestRunner.onSaveDebounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay in milliseconds before running tests on save"
        },
        "liveTestRunner.hangTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Stop a single test that runs longer than this many seconds (e.g. an infinite loop, which blocks Jest's own testTimeout) and mark its file failed, so the rest of the run continues. Loading a file does not count. 0 disables the limit."
        },
        "liveTestRunner.coverageExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra glob patterns of source files to leave out of the coverage totals (node_modules, test files, configs and build folders are always excluded), e.g. [\"**/stories/**\"]."
        },
        "liveTestRunner.testFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.test.*",
            "**/*.spec.*",
            "**/__tests__/**/*.*"
          ],
          "description": "Glob patterns for test files. Files your Jest config runs (jest --listTests) are added even when no pattern matches them."
        },
        "liveTestRunner.coverageThresholds": {
          "type": "object",
          "description": "Coverage percentage thresholds for colour-coding. Below 'red' = red, below 'amber' = amber, at or above 'amber' = green. Defaults: red=50, amber=80.",
          "default": {},
          "properties": {
            "red": {
              "type": "number",
              "default": 50,
              "description": "Coverage % below which a metric is shown in red (default 50)"
            },
            "amber": {
              "type": "number",
              "default": 80,
              "description": "Coverage % at or above which a metric is green; between red and amber = amber (default 80)"
            }
          }
        },
        "liveTestRunner.durationThresholds": {
          "type": "object",
          "description": "Duration thresholds (ms) for colour-coding test times. Green < amber ≤ yellow < red.",
          "default": {},
          "properties": {
            "testAmberMs": {
              "type": "number",
              "default": 100,
              "description": "Individual test: amber threshold in ms (default 100)"
            },
            "testRedMs": {
              "type": "number",
              "default": 500,
              "description": "Individual test: red threshold in ms (default 500)"
            },
            "suiteAmberMs": {
              "type": "number",
              "default": 500,
              "description": "Suite: amber threshold in ms (default 500)"
            },
            "suiteRedMs": {
              "type": "number",
              "default": 2000,
              "description": "Suite: red threshold in ms (default 2000)"
            },
            "fileAmberMs": {
              "type": "number",
              "default": 1000,
              "description": "File: amber threshold in ms (default 1000)"
            },
            "fileRedMs": {
              "type": "number",
              "default": 5000,
              "description": "File: red threshold in ms (default 5000)"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --minify",
    "compile": "node esbuild.js",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@live-test-runner/core": "workspace:*",
    "@live-test-runner/runner": "workspace:*"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  }
}
